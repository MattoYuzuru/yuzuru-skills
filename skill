#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="${SOURCE_DIR}/${SOURCE}" ;;
  esac
done

REPO_ROOT="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
COMMAND="${1:-install}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$COMMAND" in
  list|ls) exec "${REPO_ROOT}/yuzuru" list --kind skill "$@" ;;
  install|add) exec "${REPO_ROOT}/yuzuru" skill install "$@" ;;
  uninstall|remove|rm) exec "${REPO_ROOT}/yuzuru" skill uninstall "$@" ;;
  new|init) exec "${REPO_ROOT}/yuzuru" skill new "$@" ;;
  validate|check) exec "${REPO_ROOT}/yuzuru" skill validate "$@" ;;
  update|upgrade) exec "${REPO_ROOT}/yuzuru" update "$@" ;;
  doctor|status) exec "${REPO_ROOT}/yuzuru" doctor "$@" ;;
  help|-h|--help) exec "${REPO_ROOT}/yuzuru" skill --help ;;
  *)
    printf 'error: unknown skill command: %s\n' "$COMMAND" >&2
    exec "${REPO_ROOT}/yuzuru" skill --help
    ;;
esac
