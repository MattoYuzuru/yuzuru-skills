{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MattoYuzuru/yuzuru-skills/plugins/agent-orchestration/skills/agent-orchestration/references/orchestration-plan.schema.json",
  "title": "Agent Orchestration Plan v1",
  "description": "Declared plan state. Graph, resources, admission and passed completion checks are additionally validated by plan.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "objective",
    "limits",
    "tasks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrent",
        "max_depth"
      ],
      "properties": {
        "max_concurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "token_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    },
    "spent_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "dependencies",
          "status",
          "owner",
          "write_paths",
          "exclusive_resources",
          "acceptance_checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
            "minLength": 1,
            "maxLength": 64
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
              "minLength": 1,
              "maxLength": 64
            },
            "minItems": 0,
            "maxItems": 200,
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "write_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "exclusive_resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "acceptance_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "estimated_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "revision",
              "environment",
              "checks"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "checks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command",
                    "outcome"
                  ],
                  "properties": {
                    "command": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "passed",
                        "failed",
                        "skipped"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "required": [
                "evidence"
              ]
            }
          }
        ]
      }
    }
  }
}
