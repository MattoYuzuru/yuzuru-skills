{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent orchestration run results v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "experiment_id", "study_phase", "policy_revision", "data_kind", "runs"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "experiment_id": {"$ref": "#/$defs/id"},
    "study_phase": {"type": "string", "enum": ["orchestration", "routing"]},
    "policy_revision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "data_kind": {"type": "string", "enum": ["synthetic", "observed"]},
    "runs": {"type": "array", "minItems": 1, "maxItems": 300, "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_id", "arm", "repetition", "revision", "host", "model", "effort", "outcome", "wall_seconds", "tokens", "api_cost_usd", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "case_id": {"$ref": "#/$defs/id"},
        "arm": {"type": "string", "enum": ["single", "fixed", "adaptive"]},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "revision": {"$ref": "#/$defs/label"},
        "host": {"$ref": "#/$defs/label"},
        "model": {"$ref": "#/$defs/label"},
        "effort": {"$ref": "#/$defs/label"},
        "outcome": {"type": "string", "enum": ["accepted", "failed", "timeout"]},
        "wall_seconds": {"type": "number", "minimum": 0, "maximum": 1000000000},
        "tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
        "api_cost_usd": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000000},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
        "native_usage": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["unit", "value"],
          "properties": {
            "unit": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
            "value": {"type": "number", "minimum": 0, "maximum": 1000000000000000}
          }
        }
      }
    }
  }
}
