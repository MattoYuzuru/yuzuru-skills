{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yuzuru Plugin Evaluation Contract",
  "type": "object",
  "required": [
    "version",
    "plugin",
    "should_trigger",
    "should_not_trigger",
    "routing",
    "safety",
    "artifact_quality"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "plugin": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "should_trigger": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "should_not_trigger": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "routing": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "safety": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact_quality": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
