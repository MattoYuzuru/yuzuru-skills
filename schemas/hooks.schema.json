{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Plugin Hooks",
  "type": "object",
  "required": ["hooks"],
  "additionalProperties": false,
  "properties": {
    "hooks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["hooks"],
          "additionalProperties": true,
          "properties": {
            "matcher": {"type": "string"},
            "hooks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["type", "command"],
                "additionalProperties": true,
                "properties": {
                  "type": {"const": "command"},
                  "command": {"type": "string", "minLength": 1},
                  "timeout": {"type": "integer", "minimum": 1, "maximum": 120},
                  "statusMessage": {"type": "string", "maxLength": 120}
                }
              }
            }
          }
        }
      }
    }
  }
}
